{
  "display_information": {
    "name": "Nudge",
    "description": "Reminds you to follow up on unanswered Slack questions",
    "background_color": "#000000"
  },
  "features": {
    "bot_user": {
      "display_name": "Nudge",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/nudge",
        "url": "https://nudge.labs.vercel.dev/api/slack/commands",
        "description": "Configure your reminder schedule",
        "usage_hint": "[9am] [5pm] or [off]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://nudge.labs.vercel.dev/api/slack/oauth/callback"
    ],
    "scopes": {
      "user": [
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "search:read"
      ],
      "bot": [
        "chat:write",
        "im:write",
        "commands"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://nudge.labs.vercel.dev/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
